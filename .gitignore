# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Output artifacts
*.png
*.gif
!IceSpell/preview/*.png
!IceSpell_Quest/sprite_preview/*.png

# Sprite extraction output folders (from --extract commands)
/[A-Z][A-Z]*_*/

# Large zip downloads
*.zip

# Scratch/utility scripts (root-level only, not mod subfolders)
/utility/

# Kiro settings (machine-specific)
.kiro/settings/

# Local game data path config (see .env.example)
.env

# Game data files (now in the separate Majesty_Files repo -- see README.md
# and game_paths.py). Ignored here in case a modder keeps a local copy of
# Majesty_Files nested inside this repo instead of as a sibling folder.
/Data/
/DataMX/
/Music/
/Quests/
/QuestsMX/
/SDK/
/RGSeditor.7z
