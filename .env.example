# Copy this file to `.env` and set MAJESTY_GAME_PATH to point at your
# Majesty HD game data. This can be:
#   - A checkout of https://github.com/BrandonWill/Majesty_Files
#   - Your Steam install: C:\Program Files (x86)\Steam\steamapps\common\Majesty HD
#
# If unset, game_paths.py falls back to (in order):
#   1. ../Majesty_Files (sibling of this repo)
#   2. The default Steam install path
#
# .env is gitignored -- every modder sets their own local path here.

MAJESTY_GAME_PATH=C:\path\to\Majesty_Files
